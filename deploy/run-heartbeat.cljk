#!/usr/bin/env kbb
;; One repository-local kaname heartbeat, host-seamed for kbb AND bb
;; (kaname.nbb-compat carries the two-host branches; kotoba.datom's portable
;; builders carry CID byte-identity — only *sha256-hex* is rebound, per its
;; documented host contract).
(require '[kotoba.lang.text :as str]
         '[kaname.nbb-compat :as compat]
         '[kaname.autorun :as autorun]
         '[kaname.methods.join :as join]
         '[kaname.methods.kotoba :as kotoba])

(compat/install!)

(defn operator-did []
  (let [pid (some->> (:out (compat/sh "pgrep" "-f" "kotoba-server"))
                     str/split-lines first)]
    (when (seq pid)
      (some->> (:out (compat/sh "ps" "eww" pid))
               (re-find #"(?:^|\s)KOTOBA_AGENT_DID=([^\s]+)")
               second))))

(let [{:keys [actor-root repo-roots]} (join/default-resolution)
      log-path (compat/path-join actor-root kotoba/default-log)
      cycle (count (compat/read-log log-path))
      result (autorun/beat
              {:actor-root actor-root
               :repo-roots repo-roots
               :log-path log-path
               :tx-id (str "kaname-" cycle)
               :as-of (str "as-of:" cycle)
               :live? false
               :bridge? true
               :operator-did (operator-did)})]
  (println (select-keys result [:point :world :mirrors :appended :head :bridge])))
