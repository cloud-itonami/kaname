        io.github.kotoba-lang/edn {:git/sha "79dba32c8892058842c57783f06a2dfe4601aeb0"}
       io.github.kotoba-lang/langgraph
        {:local/root "../../kotoba-lang/langgraph"}
        com.etzhayyim/kotoba-datom
        {:local/root "../com-etzhayyim-kotoba-datom"}
        kotoba-lang/ie-flow
        {:local/root "../com-etzhayyim-ie-flow"}
        com.etzhayyim/social-publication
        {:local/root "../com-etzhayyim-social-publication"}}
 :tasks {test {:doc "Run all standalone kaname suites"
               :task (load-file "run_tests.cljk")}
         heartbeat {:doc "Run one repository-local heartbeat"
                    :task (do (require 'kaname.autorun)
                              ((resolve 'kaname.autorun/-main)))}}}
