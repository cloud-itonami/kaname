{"lexicon" 1,
 "id" "com.etzhayyim.kaname.osekkaiProposal",
 "defs"
 {"main"
  {"type" "record",
   "description"
   "An おせっかい proposal: kaname's recommendation to DISSOLVE a leverage point, handed off to ossekai (com.etzhayyim.ossekai.*) which carries it consent-bound + on-chain-logged + structural-first. kaname NEVER actuates: advisory:true, sent:false, serverKey:false (G3). The route can ONLY dissolve concentration — capture/seize/control are not representable (G2).",
   "key" "tid",
   "record"
   {"type" "object",
    "required"
    ["target"
     "route"
     "carrier"
     "advisory"
     "sent"
     "serverKey"
     "structuralFirst"],
    "properties"
    {"sent"
     {"type" "boolean",
      "const" false,
      "description"
      "drafted-unsent; ossekai dispatches under consent"},
     "leverage"
     {"type" "integer",
      "description" "L of the target, ×1000 (why it was chosen)"},
     "targetLabel" {"type" "string", "maxLength" 512},
     "serverKey"
     {"type" "boolean",
      "const" false,
      "description" "no platform-held key (ADR-2605231525)"},
     "structuralFirst"
     {"type" "boolean",
      "const" true,
      "description"
      "§1.4 — structural change before any individual nudge"},
     "rationale" {"type" "string", "maxLength" 2048},
     "route"
     {"type" "string",
      "enum"
      [":open"
       ":route-around"
       ":add-redundancy"
       ":decentralize"
       ":insufficient-evidence"],
      "description"
      "G2 — opening-only. capture/seize/control/monopolize are NOT enum members (unrepresentable)."},
     "advisory"
     {"type" "boolean",
      "const" true,
      "description" "G3 — non-binding; voters/Council decide"},
     "target"
     {"type" "string",
      "description"
      "structural-position id to open. NEVER a natural person (G1, refused at construction)."},
     "carrier"
     {"type" "string",
      "const" ":ossekai",
      "description"
      "the actor that CARRIES the intervention (consent-bound); kaname only proposes"}}}}}}
